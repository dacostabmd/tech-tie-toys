# Claude (notas de IA sobre os vídeos)
ANTHROPIC_API_KEY=

# YouTube Data API v3 (opcional: comentários dos vídeos)
YOUTUBE_API_KEY=

PORT=3000

# LiveKit (transmissão de tela/câmera)
# Local: docker run --rm -p 7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server:v1.13.11 --dev --bind 0.0.0.0
# (modo --dev usa a chave "devkey" e o segredo "secret")
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
